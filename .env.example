# Gemini (required for AI)
GEMINI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OR
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: admin metrics, leads, queue
SUPABASE_SERVICE_ROLE_KEY=

# Admin access (comma-separated)
ADMIN_EMAILS=you@company.com

# App URL
NEXT_PUBLIC_APP_URL=https://proofloop-eta.vercel.app

# Resend (Phase 2 send from approve queue)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ProofLoop <onboarding@resend.dev>

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
