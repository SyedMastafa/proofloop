# Gemini (required for AI)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase Auth + DB
# https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Use either name (new Supabase UI says Publishable key):
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OR
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# App URL (production)
NEXT_PUBLIC_APP_URL=https://proofloop-eta.vercel.app/

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=
